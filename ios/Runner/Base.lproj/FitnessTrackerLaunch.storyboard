<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24505" systemVersion="25A354" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="launch-controller">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24487"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0" y="0" width="390" height="844"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView contentMode="scaleToFill" image="LaunchBackdrop" translatesAutoresizingMaskIntoConstraints="NO" id="launch-backdrop"/>
                            <imageView contentMode="scaleAspectFit" image="FitnessTrackerLaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="launch-mark">
                                <constraints>
                                    <constraint firstAttribute="width" constant="78" id="mark-width"/>
                                    <constraint firstAttribute="height" constant="78" id="mark-height"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.980392" green="0.980392" blue="0.980392" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-backdrop" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="backdrop-top"/>
                            <constraint firstItem="launch-backdrop" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="backdrop-bottom"/>
                            <constraint firstItem="launch-backdrop" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="backdrop-left"/>
                            <constraint firstItem="launch-backdrop" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="backdrop-right"/>
                            <constraint firstItem="launch-mark" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="mark-x"/>
                            <constraint firstItem="launch-mark" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" id="mark-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackdrop" width="1" height="1"/>
        <image name="FitnessTrackerLaunchMark" width="78" height="78"/>
    </resources>
</document>
