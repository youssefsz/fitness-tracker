  "fixed_sql": [
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL UNIQUE, \"measurement\" TEXT NOT NULL CHECK(\"measurement\" IN ('repetitions', 'duration')), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"exercise_id\" TEXT NOT NULL REFERENCES exercises (id), \"activity_date\" TEXT NOT NULL CHECK((\"activity_date\" LIKE '____-__-__' AND \"activity_date\" >= '1900-01-01') AND \"activity_date\" <= '9999-12-31'), \"notes\" TEXT NULL, \"entry_order\" INTEGER NOT NULL CHECK(\"entry_order\" > 0) UNIQUE, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "exercise_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_sets\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL CHECK(\"position\" BETWEEN 0 AND 99), \"value\" INTEGER NOT NULL CHECK(\"value\" BETWEEN 1 AND 999999), PRIMARY KEY (\"id\"), UNIQUE (\"entry_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"exercise_id\" TEXT NOT NULL REFERENCES exercises (id) ON DELETE CASCADE, \"target\" INTEGER NOT NULL CHECK(\"target\" BETWEEN 1 AND 999999), \"deadline\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"exercise_id\"));"
        }
      ]
    },
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"appearance\" TEXT NOT NULL CHECK(\"appearance\" IN ('system', 'light', 'dark')), \"duration_style\" TEXT NOT NULL CHECK(\"duration_style\" IN ('clock', 'seconds')), \"haptics\" INTEGER NOT NULL CHECK (\"haptics\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "import_receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_receipts\" (\"fingerprint\" TEXT NOT NULL, \"imported_at\" TEXT NOT NULL, PRIMARY KEY (\"fingerprint\"));"
        }
      ]
    },
    {
      "name": "entries_by_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX entries_by_day ON entries (activity_date, entry_order)"
        }
      ]
    },
    {
      "name": "entries_by_exercise_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX entries_by_exercise_day ON entries (exercise_id, activity_date, entry_order)"
        }
      ]
    }
  ]
